[Unit]
Description=WINDRISE priority seat detail refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/windrise/Daily-Reports
ExecStart=/home/ubuntu/windrise/Daily-Reports/automation/server/run_tide_details.sh
TimeoutStartSec=2h
Nice=5
