[Unit]
Description=Scan for new WINDRISE patterns every 3 hours on trading weekdays

[Timer]
OnCalendar=Mon..Fri *-*-* 09:30:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 12:30:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 15:30:00 Asia/Shanghai
Persistent=false
RandomizedDelaySec=20
Unit=windrise-pattern-alert.service

[Install]
WantedBy=timers.target
